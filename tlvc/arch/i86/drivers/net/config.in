#
# Network device driver configuration
#

mainmenu_option next_comment
	comment 'Network device drivers'
	comment 'Do not choose more than 3'
	bool 'Ethernet device support (ISA only)' CONFIG_ETH y
	if [ "$CONFIG_ETH" = "y" ]; then
		bool 'NE2K'			CONFIG_ETH_NE2K y
		bool 'WD80x3/SMC8x16'		CONFIG_ETH_WD y
		bool '3Com 3C509'		CONFIG_ETH_EL3 n
		bool 'Intel EtherExpress 16'	CONFIG_ETH_EE16 n
		bool 'AMD Lance/PCnet/79C760'	CONFIG_ETH_LANCE y

	fi
endmenu
