.sp
.ce
.B "Ex command addresses"
.PP
.nf
.ta .6i 1.6i 2.2i
\fIn\fR	line \fIn\fR	/\fIpat\fR	next with \fIpat\fR
\&\fB.\fR	current	?\fIpat\fR	previous with \fIpat\fR
\fB$\fR	last	\fIx\-n\fR	\fIn\fR before \fIx\fR
+	next	\fIx,y\fR	\fIx\fR through \fIy\fR
\-	previous	\'\fIx\fR	marked with \fIx\fR
+\fIn\fR	\fIn\fR forward	\'\'	previous context
%	1,$
.fi
.sp
.ce
.B "Specifying terminal type"
.PP
.nf
.ta 2.4i
\fB% setenv TERM\fI type\fR	\fIcsh\fR
\fB$ TERM=\fItype\fB; export TERM\fR	\fIsh\fR
.fi
.sp
