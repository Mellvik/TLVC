.ce
.B "Initializing options"
.PP
.nf
.ta 1.4i
\fBEXINIT\fR	place \fBset\fR's here in environment var.
\fBset\fI x\fR	enable option
\fBset no\fIx\fR	disable option
\fBset\fI x\fB=\fIval\fR	give value \fIval\fR
\fBset\fR	show changed options
\fBset all\fR	show all options
\fBset\fI x\fB?\fR	show value of option \fIx\fR
.fi
.sp
.ce
.B "Useful options"
.PP
.nf
.ta 1.4i 2i
\fBautoindent\fR	ai	supply indent
\fBautowrite\fR	aw	write before changing files
\fBignorecase\fR	ic	in scanning
\fBlist\fR		print ^I for tab, $ at end
\fBmagic\fR		\fB. [ *\fR special in patterns
\fBnumber\fR	nu	number lines
\fBparagraphs\fR	para	macro names which start ...
\fBredraw\fR		simulate smart terminal
\fBscroll\fR		command mode lines
\fBsections\fR	sect	macro names ...
\fBshiftwidth\fR	sw	for \fB< >\fR, and input \fB^D\fR
\fBshowmatch\fR	sm	to ) and } as typed
\fBslowopen\fR	slow	choke updates during insert
\fBwindow\fR		visual mode lines
\fBwrapscan\fR	ws	around end of buffer?
\fBwrapmargin\fR	wm	automatic line splitting
.fi
.sp
.ce
.B "Scanning pattern formation"
.PP
.nf
.ta 1.2i
\fB^\fR	beginning of line
\fB$\fR	end of line
\&\fB.\fR	any character
\fB\e<\fR	beginning of word
\fB\e>\fR	end of word
\fB[\fIstr\fB]\fR	any char in \fIstr\fR
\fB[^\fIstr\fB]\fR	... not in \fIstr\fR
\fB[\fIx\-y\fB]\fR	... between \fIx\fR and \fIy\fR
\fB*\fR	any number of preceding
.fi
.sp
